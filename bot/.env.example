# ─── .env.example ──────────────────────────────────────────────────────────
# Template for the credentials the bot needs. Copy this file to ".env" and fill
# in your real values. The real .env is git-ignored and must NEVER be committed.
#
#   cp .env.example .env        # then edit .env with your actual key
#
# Get your API key from the TopstepX dashboard (not your login password — the
# generated API key).

# Your TopStep account username
TOPSTEP_USERNAME=

# Your TopStep API key (keep this secret — anyone with it can trade your account)
TOPSTEP_API_KEY=

# Instrument: "ES" (full S&P, $50/pt) or "MES" (micro, $5/pt).
# The CHOCH strategy is calibrated for ES — leave this as ES for the CHOCH bot.
INSTRUMENT=ES
